@model eVote360Pro.Core.Application.ViewModels.ResultadoElectoral.ResultadoElectoralIndexViewModel

@{
    ViewData["Title"] = "Resultados Electorales";
}

<style>
    .page-header {
        margin-bottom: 2rem;
    }

        .page-header h1 {
            font-family: 'Syne', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: #1B3A6B;
            margin: 0 0 .35rem;
        }

        .page-header p {
            font-size: .9rem;
            color: #6B7280;
            margin: 0;
        }

    .content-card {
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .btn-main {
        background: #2563EB;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: .55rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-main:hover {
            background: #1D4ED8;
            color: #fff;
            text-decoration: none;
        }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .85rem;
    }

        .custom-table thead {
            background: #EFF4FF;
        }

        .custom-table th {
            color: #1B3A6B;
            font-weight: 700;
            padding: .75rem;
            border-bottom: 1px solid #E5E7EB;
        }

        .custom-table td {
            padding: .75rem;
            border-bottom: 1px solid #F3F4F6;
            color: #374151;
        }

        .custom-table tbody tr:hover {
            background: #F9FAFB;
        }

    .winner {
        color: #047857;
        font-weight: bold;
    }

    .tie {
        color: #B91C1C;
        font-weight: bold;
    }
</style>

<div class="page-header">
    <h1>Resultados Electorales</h1>
    <p>@Model.NombreEleccion - @Model.FechaRealizacion.ToShortDateString()</p>
</div>

<div class="content-card">

    <div class="mb-3">
        <a asp-controller="Eleccion"
           asp-action="Index"
           class="btn-main">
            Volver a Elecciones
        </a>
    </div>

    <table class="custom-table">
        <thead>
            <tr>
                <th>Puesto</th>
                <th>Candidato</th>
                <th>Votos</th>
                <th>%</th>
                <th>Estado</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model.ResultadosPorPuesto)
            {
                <tr>
                    <td>@item.NombrePuesto</td>
                    <td>@item.NombreCandidato</td>
                    <td>@item.CantidadVotos</td>
                    <td>@item.Porcentaje %</td>

                    <td>
                        @if (item.EsEmpate)
                        {
                            <span class="tie">
                                Empate
                            </span>
                        }
                        else
                        {
                            <span class="winner">
                                Ganador
                            </span>
                        }
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>