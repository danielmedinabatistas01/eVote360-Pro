@model eVote360Pro.Core.Application.ViewModels.PuestoElectivo.PuestoElectivoViewModel

@{
    bool isEdit = Model != null && Model.Id > 0;
    ViewData["Title"] = isEdit ? "Editar Puesto Electivo" : "Crear Puesto Electivo";
}

<style>
    .page-header {
        margin-bottom: 2rem;
    }

    .page-header h1 {
        font-family: 'Syne', sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        color: #1B3A6B;
        margin: 0 0 .35rem;
    }

    .page-header p {
        font-size: .9rem;
        color: #6B7280;
        margin: 0;
    }

    .content-card {
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        padding: 1.5rem;
        max-width: 700px;
        margin: 0 auto;
        box-shadow: 0 4px 12px rgba(0,0,0,.04);
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        gap: .75rem;
        margin-top: 1.5rem;
        flex-wrap: wrap;
    }
</style>

<div class="page-header">
    <h1>@(isEdit ? "Editar Puesto Electivo" : "Crear Puesto Electivo")</h1>
    <p>Complete los datos del cargo electoral.</p>
</div>

<div class="content-card">
    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input asp-for="Id" type="hidden" />

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre del puesto</label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Presidente, Senador, Diputado" />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="4"
                      placeholder="Describa brevemente el puesto electivo"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger small"></span>
        </div>

        @if (isEdit)
        {
            <div class="form-check mb-3">
                <input asp-for="EsActivo" class="form-check-input" />
                <label asp-for="EsActivo" class="form-check-label">
                    Puesto activo
                </label>
            </div>
        }
        else
        {
            <input asp-for="EsActivo" type="hidden" />
        }

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i>
                Volver
            </a>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i>
                @(isEdit ? "Guardar Cambios" : "Crear Puesto")
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}