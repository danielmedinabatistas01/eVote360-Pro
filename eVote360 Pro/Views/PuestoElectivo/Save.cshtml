@model eVote360Pro.Core.Application.ViewModels.PuestoElectivo.PuestoElectivoViewModel
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Editar Puesto Electivo" : "Nuevo Puesto Electivo";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h4>@(isEdit ? "Modificar Datos de Puesto Electivo" : "Registrar Nuevo Puesto Electivo")</h4>
        </div>
        <div class="card-body">

            <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="EsActivo" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombre del Puesto</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Regresar</a>
                    <button type="submit" class="btn btn-primary">Guardar Puesto</button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
