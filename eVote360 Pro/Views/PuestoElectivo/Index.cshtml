@model List<eVote360Pro.Core.Application.ViewModels.PuestoElectivo.PuestoElectivoViewModel>
@{
    ViewData["Title"] = "Puestos Electivos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Mantenimiento de Puestos Electivos</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Registrar Puesto Electivo</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">No hay puestos electivos registrados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var puesto in Model)
                        {
                            <tr>
                                <td><strong>@puesto.Nombre</strong></td>
                                <td>@puesto.Descripcion</td>
                                <td>
                                    @if (puesto.EsActivo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@puesto.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i> Editar</a>
                                    <form asp-action="DeletePost" asp-route-id="@puesto.Id" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas desactivar este puesto electivo?');">
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Desactivar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
