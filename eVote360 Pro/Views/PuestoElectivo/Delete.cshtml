@model eVote360Pro.Core.Application.ViewModels.PuestoElectivo.SavePuestoElectivoViewModel

@{
    bool activar = !Model.EsActivo;
}

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-dark text-white">

            <h4>
                @(activar ? "Activar Partido" : "Desactivar Partido")
            </h4>

        </div>

        <div class="card-body">

            <h5>
                ¿Está seguro que desea
                @(activar ? "activar" : "desactivar")
                este partido?
            </h5>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">
                    Nombre
                </dt>

                <dd class="col-sm-9">
                    @Model.Nombre
                </dd>


            </dl>

            <form asp-action="DeletePost" method="post">

                <input asp-for="Id" type="hidden" />

                @if (activar)
                {
                    <button class="btn btn-success">
                        Activar
                    </button>
                }
                else
                {
                    <button class="btn btn-danger">
                        Desactivar
                    </button>
                }

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>