@model List<eVote360Pro.Core.Application.ViewModels.AsignacionDirigente.AsignacionDirigenteViewModel>
@{
    ViewData["Title"] = "Asignaciones de Dirigentes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Asignación de Dirigentes Políticos</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nueva Asignación</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre del Dirigente</th>
                        <th>Partido Político Asignado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">No hay dirigentes asignados actualmente.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var asignacion in Model)
                        {
                            <tr>
                                <td><strong>@asignacion.NombreDirigente</strong></td>
                                <td>@asignacion.NombrePartido</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@asignacion.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i> Editar</a>
                                    <form asp-action="Delete" asp-route-id="@asignacion.Id" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar esta asignación de dirigente?');">
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
