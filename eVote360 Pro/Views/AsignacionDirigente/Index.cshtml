@model List<eVote360Pro.Core.Application.ViewModels.AsignacionDirigente.AsignacionDirigenteViewModel>

@{
    ViewData["Title"] = "Asignación de Dirigentes";
}

<style>
    .page-header {
        margin-bottom: 2rem;
    }

        .page-header h1 {
            font-family: 'Syne', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: #1B3A6B;
            margin: 0 0 .35rem;
        }

        .page-header p {
            font-size: .9rem;
            color: #6B7280;
            margin: 0;
        }

    .content-card {
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        padding: 1.5rem;
        max-width: 1000px;
        margin: 0 auto;
        box-shadow: 0 4px 12px rgba(0,0,0,.04);
    }

    .top-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .btn-main, .btn-back {
        border-radius: 8px;
        padding: .55rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-main {
        background: #2563EB;
        color: #fff;
    }

        .btn-main:hover {
            background: #1D4ED8;
            color: #fff;
        }

    .btn-back {
        background: #F8FAFC;
        color: #1B3A6B;
        border: 1px solid #E5E7EB;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .85rem;
    }

        .custom-table thead {
            background: #EFF4FF;
        }

        .custom-table th,
        .custom-table td {
            padding: .75rem;
            border-bottom: 1px solid #E5E7EB;
            vertical-align: middle;
        }

        .custom-table th {
            color: #1B3A6B;
            font-weight: 700;
        }

        .custom-table td {
            color: #374151;
        }

        .custom-table tbody tr:hover {
            background: #F9FAFB;
        }

    .empty-state {
        text-align: center;
        padding: 2rem;
        color: #6B7280;
        background: #F8FAFC;
        border: 1px dashed #CBD5E1;
        border-radius: 12px;
    }
</style>

<div class="page-header">
    <h1>Asignación de Dirigentes</h1>
    <p>Relación entre usuarios dirigentes políticos y partidos políticos.</p>
</div>

<div class="content-card">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="top-actions">
        <a asp-action="Create" class="btn-main">
            <i class="bi bi-person-plus"></i>
            Nueva Asignación
        </a>

        <a asp-controller="HomeAdministrador" asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left"></i>
            Volver al Home
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-person-check fs-1 d-block mb-2"></i>
            No hay dirigentes asignados a partidos políticos.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Dirigente</th>
                        <th>Partido Político</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var asignacion in Model)
                    {
                        <tr>
                            <td><strong>@asignacion.NombreDirigente</strong></td>
                            <td>@asignacion.NombrePartido</td>
                            <td class="text-end">
                                <a asp-action="Edit"
                                   asp-route-id="@asignacion.Id"
                                   class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i>
                                    Editar
                                </a>

                                <form asp-action="DeleteConfirmed"
                                      asp-route-id="@asignacion.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('¿Seguro que deseas eliminar esta asignación?');">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i>
                                        Eliminar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>