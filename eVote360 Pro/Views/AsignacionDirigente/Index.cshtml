@model List<eVote360Pro.Core.Application.ViewModels.AsignacionDirigente.AsignacionDirigenteViewModel>
@{
    ViewData["Title"] = "Asignaciones de Dirigentes";
}
<style>
    .page-header {
        margin-bottom: 2rem;
    }

        .page-header h1 {
            font-family: 'Syne', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: #1B3A6B;
            margin: 0 0 .35rem;
        }

        .page-header p {
            font-size: .9rem;
            color: #6B7280;
            margin: 0;
        }

    .content-card {
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        padding: 1.5rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .top-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .btn-main {
        background: #2563EB;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: .55rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-main:hover {
            background: #1D4ED8;
            color: #fff;
            text-decoration: none;
        }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .85rem;
    }

        .custom-table thead {
            background: #EFF4FF;
        }

        .custom-table th {
            color: #1B3A6B;
            font-weight: 700;
            padding: .75rem;
            border-bottom: 1px solid #E5E7EB;
        }

        .custom-table td {
            padding: .75rem;
            border-bottom: 1px solid #F3F4F6;
            color: #374151;
            vertical-align: middle;
        }

        .custom-table tbody tr:hover {
            background: #F9FAFB;
        }

    .actions {
        display: flex;
        gap: .4rem;
        flex-wrap: wrap;
    }

    .btn-edit {
        background: #FFFBEB;
        color: #B45309;
        border-radius: 6px;
        padding: .35rem .65rem;
        font-size: .78rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-edit:hover {
            background: #FEF3C7;
            color: #92400E;
            text-decoration: none;
        }

    .btn-delete {
        background: #FEF2F2;
        color: #B91C1C;
        border-radius: 6px;
        padding: .35rem .65rem;
        font-size: .78rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-delete:hover {
            background: #FEE2E2;
            color: #991B1B;
            text-decoration: none;
        }

    .btn-success-custom {
        background: #ECFDF5;
        color: #047857;
        border-radius: 6px;
        padding: .35rem .65rem;
        font-size: .78rem;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-info-custom {
        background: #EFF6FF;
        color: #1D4ED8;
        border-radius: 6px;
        padding: .35rem .65rem;
        font-size: .78rem;
        font-weight: 600;
        text-decoration: none;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Asignación de Dirigentes Políticos</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nueva Asignación</a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre del Dirigente</th>
                        <th>Partido Político Asignado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">No hay dirigentes asignados actualmente.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var asignacion in Model)
                        {
                            <tr>
                                <td><strong>@asignacion.NombreDirigente</strong></td>
                                <td>@asignacion.NombrePartido</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@asignacion.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i> Editar</a>
                                    <form asp-action="DeleteConfirmed"
                                          asp-route-id="@asignacion.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('¿Seguro que deseas eliminar esta asignación?');">
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
