@model eVote360Pro.Core.Application.ViewModels.Usuario.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Iniciar sesión - eVote360 Pro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            body {
                background: #F8FAFC;
                min-height: 100vh;
            }

            .navbar-custom {
                background: #FFFFFF;
                border-bottom: 1px solid #E5E7EB;
                padding: 1rem 2rem;
            }

            .navbar-brand-wrapper {
                display: flex;
                align-items: center;
                gap: 1rem;
            }

            .logo-box {
                width: 54px;
                height: 54px;
                background: #EEF2FF;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .brand-title {
                color: #1B3A6B;
                font-size: 1.8rem;
                font-weight: 700;
                margin: 0;
            }

            .back-btn {
                border: 1px solid #1B3A6B;
                color: #1B3A6B;
                font-weight: 600;
                border-radius: 8px;
                padding: .5rem 1rem;
                text-decoration: none;
            }

                .back-btn:hover {
                    background: #1B3A6B;
                    color: white;
                }

            .login-wrapper {
                min-height: calc(100vh - 90px);
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 2rem;
            }

            .content-card {
                width: 100%;
                max-width: 500px;
                background: white;
                border: 1px solid #E5E7EB;
                border-radius: 16px;
                padding: 2rem;
                box-shadow: 0 4px 12px rgba(0,0,0,.04);
            }

            .page-header {
                text-align: center;
                margin-bottom: 2rem;
            }

                .page-header h1 {
                    font-size: 1.8rem;
                    font-weight: 700;
                    color: #1B3A6B;
                    margin: 0;
                }

                .page-header p {
                    color: #6B7280;
                    margin-top: .5rem;
                    margin-bottom: 0;
                }

            .icon-box {
                width: 60px;
                height: 60px;
                background: #EFF6FF;
                color: #1B3A6B;
                border-radius: 14px;
                display: inline-flex;
                justify-content: center;
                align-items: center;
                margin-bottom: 1rem;
            }

            .form-label {
                color: #1B3A6B;
                font-weight: 600;
            }

            .form-control {
                border-radius: 8px;
                border: 1px solid #E5E7EB;
                padding: .75rem;
            }

                .form-control:focus {
                    border-color: #2563EB;
                    box-shadow: 0 0 0 .2rem rgba(37,99,235,.15);
                }

            .action-btn {
                background: #2563EB;
                color: white;
                border: none;
                padding: .85rem;
                border-radius: 8px;
                font-weight: 600;
                transition: .2s;
            }

                .action-btn:hover {
                    background: #1D4ED8;
                    color: white;
                }

            .btn-create {
                display: inline-block;
                width: 100%;
                text-align: center;
                margin-top: .75rem;
                background: #F8FAFC;
                color: #1B3A6B;
                border: 1px solid #E5E7EB;
                border-radius: 8px;
                padding: .85rem;
                font-weight: 600;
                text-decoration: none;
                transition: .2s;
            }

                .btn-create:hover {
                    background: #EEF2FF;
                    color: #1B3A6B;
                    text-decoration: none;
                }

            .footer-text {
                color: #6B7280;
                font-size: .85rem;
            }
    </style>
</head>

<body>

    <nav class="navbar navbar-custom">
        <div class="container-fluid">

            <div class="navbar-brand-wrapper">
                <div class="logo-box">
                    <i class="bi bi-check-square-fill fs-3 text-primary"></i>
                </div>

                <h1 class="brand-title">
                    eVote360 Pro
                </h1>
            </div>

            <a asp-controller="ProcesoVotacion"
               asp-action="Index"
               class="btn back-btn">
                <i class="bi bi-arrow-left"></i>
                Volver a votación
            </a>

        </div>
    </nav>

    <main class="login-wrapper">
        <div class="content-card">

            <div class="page-header">
                <div class="icon-box">
                    <i class="bi bi-person-lock fs-3"></i>
                </div>

                <h1>Iniciar sesión</h1>

                <p>
                    Acceso para administradores y dirigentes políticos.
                </p>
            </div>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="NombreUsuario" class="form-label">Nombre de Usuario</label>

                    <input asp-for="NombreUsuario"
                           class="form-control"
                           placeholder="Ingrese su usuario" />

                    <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Contrasena" class="form-label">Contraseña</label>

                    <input asp-for="Contrasena"
                           type="password"
                           class="form-control"
                           placeholder="Ingrese su contraseña" />

                    <span asp-validation-for="Contrasena" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn action-btn w-100">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Iniciar sesión
                </button>

            </form>

            <div class="text-center footer-text mt-4">
                <i class="bi bi-shield-lock"></i>
                Acceso seguro · eVote360 Pro
            </div>

        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>