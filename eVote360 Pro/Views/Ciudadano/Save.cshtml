@using eVote360Pro.Core.Application.ViewModels.Ciudadano
@model SaveCiudadanoViewModel

@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Editar Ciudadano" : "Nuevo Ciudadano";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h4>@(isEdit ? "Modificar Datos de Ciudadano" : "Inscribir Nuevo Ciudadano")</h4>
        </div>
        <div class="card-body">

            <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                @if (isEdit)
                {
                    <div class="mb-3 form-check">
                        <input asp-for="EsActivo" type="checkbox" class="form-check-input" />
                        <label asp-for="EsActivo" class="form-check-label">Habilitado / Activo</label>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="EsActivo" />
                }

                <div class="mb-3">
                    <label asp-for="NumeroIdentificacion" class="form-label">Cédula de Identidad</label>
                    <input asp-for="NumeroIdentificacion" class="form-control" placeholder="XXX-XXXXXXX-X" readonly="@isEdit" />
                    <span asp-validation-for="NumeroIdentificacion" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label">Nombres</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Apellido" class="form-label">Apellidos</label>
                    <input asp-for="Apellido" class="form-control" />
                    <span asp-validation-for="Apellido" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CorreoElectronico" class="form-label">Correo Electrónico</label>
                    <input asp-for="CorreoElectronico" class="form-control" type="email" />
                    <span asp-validation-for="CorreoElectronico" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Regresar</a>
                    <button type="submit" class="btn btn-primary">Guardar Ciudadano</button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}