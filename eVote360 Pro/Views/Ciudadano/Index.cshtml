@using eVote360Pro.Core.Application.ViewModels.Ciudadano
@model List<CiudadanoViewModel>

@{
    ViewData["Title"] = "Ciudadanos";
}

<style>
    .top-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .btn-main {
        background: #2563EB;
        color: #fff;
        border-radius: 8px;
        padding: .55rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-back {
        background: #F8FAFC;
        color: #1B3A6B;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        padding: .55rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .85rem;
    }

    .custom-table thead {
        background: #EFF4FF;
    }

    .custom-table th,
    .custom-table td {
        padding: .75rem;
        border-bottom: 1px solid #E5E7EB;
        vertical-align: middle;
    }

    .actions {
        display: flex;
        gap: .4rem;
        flex-wrap: wrap;
    }

    .empty-state {
        text-align: center;
        padding: 2rem;
        color: #6B7280;
        background: #F8FAFC;
        border: 1px dashed #CBD5E1;
        border-radius: 12px;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Padrón de Ciudadanos</h2>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.HasActiveElection == true)
    {
        <div class="alert alert-warning mb-3">
            <i class="bi bi-exclamation-triangle-fill"></i>
            No se pueden modificar ciudadanos mientras exista una elección activa.
        </div>
    }

    <div class="top-actions">
        @if (ViewBag.HasActiveElection == true)
        {
            <a href="#" class="btn-main disabled" style="pointer-events: none; opacity: 0.6;">
                <i class="bi bi-person-plus"></i>
                Registrar Ciudadano
            </a>
        }
        else
        {
            <a asp-action="Create" class="btn-main">
                <i class="bi bi-person-plus"></i>
                Registrar Ciudadano
            </a>
        }

        <a asp-controller="HomeAdministrador" asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left"></i>
            Volver al Home
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            No hay ciudadanos inscritos en el padrón.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Cédula / Documento</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var ciudadano in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@ciudadano.NumeroIdentificacion</td>
                            <td>@ciudadano.Nombre</td>
                            <td>@ciudadano.Apellido</td>

                            <td>
                                @if (ciudadano.EsActivo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="actions justify-content-end">
                                    @if (ViewBag.HasActiveElection == true)
                                    {
                                        <a href="#" class="btn btn-warning btn-sm disabled" style="pointer-events: none; opacity: 0.6;">
                                            <i class="bi bi-pencil"></i>
                                            Editar
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Edit" asp-route-id="@ciudadano.Id" class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil"></i>
                                            Editar
                                        </a>
                                    }

                                    @if (ViewBag.HasActiveElection == true)
                                    {
                                        @if (ciudadano.EsActivo)
                                        {
                                            <a href="#" class="btn btn-danger btn-sm disabled" style="pointer-events: none; opacity: 0.6;">
                                                <i class="bi bi-trash"></i>
                                                Desactivar
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="#" class="btn btn-success btn-sm disabled" style="pointer-events: none; opacity: 0.6;">
                                                <i class="bi bi-arrow-clockwise"></i>
                                                Activar
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        @if (ciudadano.EsActivo)
                                        {
                                            <a asp-action="Delete" asp-route-id="@ciudadano.Id" class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash"></i>
                                                Desactivar
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Delete" asp-route-id="@ciudadano.Id" class="btn btn-success btn-sm">
                                                <i class="bi bi-arrow-clockwise"></i>
                                                Activar
                                            </a>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>