@model eVote360Pro.Core.Application.ViewModels.Usuario.UsuarioActivarViewModel
<style>
    .page-header {
        margin-bottom: 2rem;
    }

        .page-header h1 {
            font-family: 'Syne', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: #1B3A6B;
            margin: 0 0 .35rem;
        }

        .page-header p {
            font-size: .9rem;
            color: #6B7280;
            margin: 0;
        }

    .content-card {
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .top-actions {
        display: flex;
        justify-content: flex-start;
        margin-bottom: 1rem;
    }

    .btn-main {
        background: #2563EB;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: .55rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-main:hover {
            background: #1D4ED8;
            color: #fff;
            text-decoration: none;
        }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .85rem;
    }

        .custom-table thead {
            background: #EFF4FF;
        }

        .custom-table th {
            color: #1B3A6B;
            font-weight: 700;
            padding: .75rem;
            border-bottom: 1px solid #E5E7EB;
        }

        .custom-table td {
            padding: .75rem;
            border-bottom: 1px solid #F3F4F6;
            color: #374151;
            vertical-align: middle;
        }

        .custom-table tbody tr:hover {
            background: #F9FAFB;
        }

    .actions {
        display: flex;
        gap: .4rem;
    }

    .btn-edit {
        background: #FFFBEB;
        color: #B45309;
        border-radius: 6px;
        padding: .35rem .65rem;
        font-size: .78rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-edit:hover {
            background: #FEF3C7;
            color: #92400E;
            text-decoration: none;
        }

    .btn-delete {
        background: #FEF2F2;
        color: #B91C1C;
        border-radius: 6px;
        padding: .35rem .65rem;
        font-size: .78rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-delete:hover {
            background: #FEE2E2;
            color: #991B1B;
            text-decoration: none;
        }
</style>

<div class="content-card">
    <h2>Activar usuario</h2>
    <p>¿Deseas activar el usuario <strong>@Model.NombreCompleto</strong>?</p>

    <form asp-action="ActivarConfirmado" method="post">
        <input asp-for="Id" type="hidden" />
        <button type="submit" class="btn-main">Activar</button>
        <a asp-action="Index" class="btn-delete">Cancelar</a>
    </form>
</div>