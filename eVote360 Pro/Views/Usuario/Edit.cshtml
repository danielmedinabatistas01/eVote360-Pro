@model eVote360Pro.Core.Application.ViewModels.Usuario.UsuarioEditViewModel
@using eVote360Pro.Core.Domain.Enums

@{
    ViewData["Title"] = "Editar usuario";
}

<style>
    .container-form {
        max-width: 700px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

        .page-header h1 {
            font-family: 'Syne', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: #1B3A6B;
            margin: 0 0 .35rem;
        }

        .page-header p {
            font-size: .9rem;
            color: #6B7280;
            margin: 0;
        }

    .content-card {
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
    }

    .btn-main {
        background: #2563EB;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: .55rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-main:hover {
            background: #1D4ED8;
            color: #fff;
        }

    .btn-delete {
        background: #FEF2F2;
        color: #B91C1C;
        border: 1px solid #FECACA;
        border-radius: 8px;
        padding: .55rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-delete:hover {
            background: #FEE2E2;
            color: #991B1B;
        }

    label {
        font-weight: 600;
        margin-bottom: .35rem;
    }
</style>

<div class="container-form">

    <div class="page-header">
        <h1>Editar usuario</h1>
        <p>Actualiza los datos del usuario seleccionado.</p>
    </div>

    <div class="content-card">
        <form asp-action="Edit" method="post">
            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nombre"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Apellido"></label>
                <input asp-for="Apellido" class="form-control" />
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NombreUsuario"></label>
                <input asp-for="NombreUsuario" class="form-control" />
                <span asp-validation-for="NombreUsuario" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CorreoElectronico"></label>
                <input asp-for="CorreoElectronico" class="form-control" />
                <span asp-validation-for="CorreoElectronico" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Contrasena">Nueva contraseña</label>
                <input asp-for="Contrasena" type="password" class="form-control" />
                <span asp-validation-for="Contrasena" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmarContrasena"></label>
                <input asp-for="ConfirmarContrasena" type="password" class="form-control" />
                <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RolUsuario"></label>
                <select asp-for="RolUsuario"
                        asp-items="Html.GetEnumSelectList<RolUsuario>()"
                        class="form-control">
                </select>
                <span asp-validation-for="RolUsuario" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Estado"></label>
                <select asp-for="Estado" class="form-control">
                    <option value="true">Activo</option>
                    <option value="false">Inactivo</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-main">
                    Actualizar
                </button>

                <a asp-action="Index" class="btn-delete">
                    Cancelar
                </a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}