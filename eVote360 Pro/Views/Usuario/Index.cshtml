@model List<eVote360Pro.Core.Application.ViewModels.Usuario.UsuarioIndexViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<style>
    .page-header {
        margin-bottom: 2rem;
    }

        .page-header h1 {
            font-family: 'Syne', sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: #1B3A6B;
            margin: 0 0 .35rem;
        }

        .page-header p {
            font-size: .9rem;
            color: #6B7280;
            margin: 0;
        }

    .content-card {
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        padding: 1.5rem;
        max-width: 1000px;
        margin: 0 auto;
        box-shadow: 0 4px 12px rgba(0,0,0,.04);
    }

    .top-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .btn-main {
        background: #2563EB;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: .55rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-main:hover {
            background: #1D4ED8;
            color: #fff;
            text-decoration: none;
        }

    .btn-back {
        background: #F8FAFC;
        color: #1B3A6B;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        padding: .55rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #EEF2FF;
            color: #1B3A6B;
            text-decoration: none;
        }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .85rem;
    }

        .custom-table thead {
            background: #EFF4FF;
        }

        .custom-table th {
            color: #1B3A6B;
            font-weight: 700;
            padding: .75rem;
            border-bottom: 1px solid #E5E7EB;
            white-space: nowrap;
        }

        .custom-table td {
            padding: .75rem;
            border-bottom: 1px solid #F3F4F6;
            color: #374151;
            vertical-align: middle;
        }

        .custom-table tbody tr:hover {
            background: #F9FAFB;
        }

    .actions {
        display: flex;
        gap: .4rem;
        flex-wrap: wrap;
    }

    .btn-edit {
        background: #FFFBEB;
        color: #B45309;
        border-radius: 6px;
        padding: .35rem .65rem;
        font-size: .78rem;
        font-weight: 600;
        text-decoration: none;
        border: none;
    }

        .btn-edit:hover {
            background: #FEF3C7;
            color: #92400E;
            text-decoration: none;
        }

    .btn-delete {
        background: #FEF2F2;
        color: #B91C1C;
        border-radius: 6px;
        padding: .35rem .65rem;
        font-size: .78rem;
        font-weight: 600;
        text-decoration: none;
        border: none;
    }

        .btn-delete:hover {
            background: #FEE2E2;
            color: #991B1B;
            text-decoration: none;
        }

    .badge-active {
        background: #ECFDF5;
        color: #047857;
        border: 1px solid #A7F3D0;
        border-radius: 999px;
        padding: .35rem .65rem;
        font-weight: 600;
        font-size: .78rem;
    }

    .badge-inactive {
        background: #FEF2F2;
        color: #B91C1C;
        border: 1px solid #FECACA;
        border-radius: 999px;
        padding: .35rem .65rem;
        font-weight: 600;
        font-size: .78rem;
    }

    .empty-state {
        text-align: center;
        padding: 2rem;
        color: #6B7280;
        background: #F8FAFC;
        border: 1px dashed #CBD5E1;
        border-radius: 12px;
    }
</style>

<div class="page-header">
    <h1>Usuarios</h1>
    <p>Listado de usuarios administrativos y dirigentes políticos.</p>
</div>

<div class="content-card">

    @if (ViewBag.HasActiveElection == true)
    {
        <div class="alert alert-warning mb-3">
            <i class="bi bi-exclamation-triangle-fill"></i>
            No se pueden modificar usuarios mientras exista una elección activa.
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="top-actions">
        @if (ViewBag.HasActiveElection == true)
        {
            <a href="#" class="btn-main disabled" style="pointer-events: none; opacity: 0.6;">
                <i class="bi bi-person-plus"></i>
                Nuevo Usuario
            </a>
        }
        else
        {
            <a asp-action="Create" class="btn-main">
                <i class="bi bi-person-plus"></i>
                Nuevo Usuario
            </a>
        }

        <a asp-controller="HomeAdministrador"
           asp-action="Index"
           class="btn-back">
            <i class="bi bi-arrow-left"></i>
            Volver al Home
        </a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            No hay usuarios registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nombre @item.Apellido</td>
                            <td>@item.NombreUsuario</td>
                            <td>@item.CorreoElectronico</td>
                            <td>@item.RolUsuario</td>
                            <td>
                                @if (item.Estado)
                                {
                                    <span class="badge-active">Activo</span>
                                }
                                else
                                {
                                    <span class="badge-inactive">Inactivo</span>
                                }
                            </td>
                            <td>
                                <div class="actions">
                                    @if (ViewBag.HasActiveElection == true)
                                     {
                                         <a href="#" class="btn-edit disabled" style="pointer-events: none; opacity: 0.6;">
                                             <i class="bi bi-pencil"></i>
                                             Editar
                                         </a>
                                     }
                                     else
                                     {
                                         <a asp-action="Edit"
                                            asp-route-id="@item.Id"
                                            class="btn-edit">
                                             <i class="bi bi-pencil"></i>
                                             Editar
                                         </a>
                                     }

                                    @if (ViewBag.HasActiveElection == true)
                                     {
                                         @if (item.Estado)
                                         {
                                             <a href="#" class="btn-delete disabled" style="pointer-events: none; opacity: 0.6;">
                                                 <i class="bi bi-person-x"></i>
                                                 Desactivar
                                             </a>
                                         }
                                         else
                                         {
                                             <a href="#" class="btn-edit disabled" style="pointer-events: none; opacity: 0.6;">
                                                 <i class="bi bi-person-check"></i>
                                                 Activar
                                             </a>
                                         }
                                     }
                                     else
                                     {
                                         @if (item.Estado)
                                         {
                                             <a asp-action="Desactivar"
                                                asp-route-id="@item.Id"
                                                class="btn-delete">
                                                 <i class="bi bi-person-x"></i>
                                                 Desactivar
                                             </a>
                                         }
                                         else
                                         {
                                             <a asp-action="Activar"
                                                asp-route-id="@item.Id"
                                                class="btn-edit">
                                                 <i class="bi bi-person-check"></i>
                                                 Activar
                                             </a>
                                         }
                                     }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>