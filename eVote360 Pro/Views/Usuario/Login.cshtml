@model eVote360Pro.Core.Application.ViewModels.Usuario.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<style>
    .login-wrapper {
        min-height: 85vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #F8FAFC;
    }

    .content-card {
        width: 100%;
        max-width: 500px;
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 8px 25px rgba(0,0,0,.05);
    }

    .page-header {
        text-align: center;
        margin-bottom: 2rem;
    }

        .page-header h1 {
            font-family: 'Syne', sans-serif;
            font-size: 2rem;
            font-weight: 700;
            color: #1B3A6B;
            margin-bottom: .5rem;
        }

        .page-header p {
            color: #6B7280;
            font-size: .95rem;
            margin: 0;
        }

    .form-label {
        font-weight: 600;
        color: #374151;
        margin-bottom: .4rem;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #D1D5DB;
        padding: .75rem;
    }

        .form-control:focus {
            border-color: #2563EB;
            box-shadow: 0 0 0 0.15rem rgba(37,99,235,.15);
        }

    .btn-main {
        width: 100%;
        background: #2563EB;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: .75rem;
        font-size: .95rem;
        font-weight: 600;
        transition: .2s;
    }

        .btn-main:hover {
            background: #1D4ED8;
            color: #fff;
        }

    .logo-circle {
        width: 70px;
        height: 70px;
        background: #EFF6FF;
        color: #2563EB;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem auto;
        font-size: 1.8rem;
        font-weight: bold;
    }

    .btn-create {
        display: inline-block;
        margin-top: .5rem;
        background: #F3F4F6;
        color: #1B3A6B;
        border: 1px solid #D1D5DB;
        border-radius: 8px;
        padding: .75rem 1rem;
        font-size: .9rem;
        font-weight: 600;
        text-decoration: none;
        width: 100%;
        text-align: center;
        transition: .2s;
    }

        .btn-create:hover {
            background: #E5E7EB;
            color: #1B3A6B;
            text-decoration: none;
        }
</style>

<div class="login-wrapper">

    <div class="content-card">

        <div class="page-header">
            <div class="logo-circle">
                🗳️
            </div>

            <h1>eVote360 Pro</h1>
            <p>Acceso para administradores y dirigentes políticos.</p>
        </div>

        <form asp-action="Login" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="NombreUsuario" class="form-label">Nombre de Usuario</label>
                <input asp-for="NombreUsuario" class="form-control" />
                <span asp-validation-for="NombreUsuario" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Contrasena" class="form-label">Contraseña</label>
                <input asp-for="Contrasena" type="password" class="form-control" />
                <span asp-validation-for="Contrasena" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-main">
                Iniciar Sesión
            </button>

            <div class="mt-3 text-center">
                <a asp-controller="Usuario"
                   asp-action="Create"
                   class="btn-create">
                    Crear Usuario
                </a>
            </div>

        </form>

    </div>

</div>