@using eVote360Pro.Core.Application.ViewModels.AlianzaPolitica
@model AlianzaDashboardViewModel

@{
    ViewData["Title"] = "Alianzas Políticas";
}

<style>
    .page-header {
        margin-bottom: 2rem;
    }

    .page-header h1 {
        font-family: 'Syne', sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        color: #1B3A6B;
        margin: 0 0 .35rem;
    }

    .page-header p {
        font-size: .9rem;
        color: #6B7280;
        margin: 0;
    }

    .content-card {
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        padding: 1.5rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .top-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }
</style>

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-4">
        <h2>Alianzas Políticas</h2>

        <a asp-action="CrearSolicitud" class="btn btn-primary">
            Nueva Solicitud
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-header bg-warning">
            <strong>Solicitudes pendientes de responder</strong>
        </div>

        <div class="card-body">
            @if (Model == null || !Model.SolicitudesPendientes.Any())
            {
                <p>No existen solicitudes pendientes.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Partido Origen</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.SolicitudesPendientes)
                        {
                            <tr>
                                <td>@item.PartidoOrigen</td>
                                <td>@item.Estado</td>
                                <td>@item.FechaSolicitud.ToShortDateString()</td>
                                <td>
                                    <a asp-action="Aceptar" asp-route-id="@item.Id" class="btn btn-success btn-sm">
                                        Aceptar
                                    </a>

                                    <a asp-action="Rechazar" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                        Rechazar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <strong>Solicitudes realizadas</strong>
        </div>

        <div class="card-body">
            @if (Model == null || !Model.SolicitudesRealizadas.Any())
            {
                <p>No existen solicitudes realizadas.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Partido Destino</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.SolicitudesRealizadas)
                        {
                            <tr>
                                <td>@item.PartidoDestino</td>
                                <td>@item.Estado</td>
                                <td>@item.FechaSolicitud.ToShortDateString()</td>
                                <td>
                                    <a asp-action="EliminarSolicitud" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                        Cancelar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-success text-white">
            <strong>Alianzas Vigentes</strong>
        </div>

        <div class="card-body">
            @if (Model == null || !Model.AlianzasVigentes.Any())
            {
                <p>No existen alianzas vigentes.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Partido Origen</th>
                            <th>Partido Destino</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.AlianzasVigentes)
                        {
                            <tr>
                                <td>@item.PartidoOrigen</td>
                                <td>@item.PartidoDestino</td>
                                <td>@item.Estado</td>
                                <td>
                                    <a asp-action="EliminarAlianza" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                        Eliminar Alianza
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

</div>