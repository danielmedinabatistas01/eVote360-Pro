@model List<eVote360Pro.Core.Application.ViewModels.AlianzaPolitica.AlianzaPoliticaViewModel>

@{
    Layout = null;
    ViewData["Title"] = "Alianzas Políticas";
}

<!DOCTYPE html>

<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Alianzas Políticas - eVote360 Pro</title>

    ```
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            body {
                background: #F8FAFC;
                min-height: 100vh;
            }

            .page-wrapper {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 2rem;
            }

            .content-card {
                width: 100%;
                max-width: 1100px;
                background: white;
                border: 1px solid #E5E7EB;
                border-radius: 16px;
                padding: 2rem;
                box-shadow: 0 4px 12px rgba(0,0,0,.04);
            }

            .page-header {
                text-align: center;
                margin-bottom: 2rem;
            }

            .icon-box {
                width: 70px;
                height: 70px;
                background: #EFF6FF;
                border-radius: 14px;
                display: inline-flex;
                justify-content: center;
                align-items: center;
                margin-bottom: 1rem;
            }

            .page-header h1 {
                color: #1B3A6B;
                font-weight: 700;
            }

            .page-header p {
                color: #6B7280;
            }

            .btn-main {
                background: #2563EB;
                color: white;
                border: none;
                border-radius: 8px;
                padding: .65rem 1rem;
                font-weight: 600;
                text-decoration: none;
            }

                .btn-main:hover {
                    background: #1D4ED8;
                    color: white;
                }

            .btn-warning-custom {
                background: #FEF3C7;
                color: #92400E;
                border-radius: 8px;
                padding: .45rem .8rem;
                text-decoration: none;
                font-weight: 600;
            }

            .badge-active {
                background: #DCFCE7;
                color: #166534;
                padding: .35rem .7rem;
                border-radius: 999px;
                font-weight: 600;
            }

            .badge-inactive {
                background: #FEE2E2;
                color: #991B1B;
                padding: .35rem .7rem;
                border-radius: 999px;
                font-weight: 600;
            }

            .table thead th {
                background: #F8FAFC;
                color: #1B3A6B;
            }
    </style>
    ```

</head>

<body>

    ```
    <main class="page-wrapper">

        <div class="content-card">

            <div class="page-header">

                <div class="icon-box">
                    <i class="bi bi-diagram-3-fill fs-2 text-primary"></i>
                </div>

                <h1>Alianzas Políticas</h1>

                <p>
                    Administración de alianzas entre partidos políticos.
                </p>

            </div>

            <div class="d-flex justify-content-end mb-3">

                <a asp-action="Create"
                   class="btn-main">
                    <i class="bi bi-plus-circle"></i>
                    Nueva Alianza
                </a>

            </div>

            <div class="table-responsive">

                <table class="table table-bordered align-middle">

                    <thead>
                        <tr>
                            <th>Partido Origen</th>
                            <th>Partido Destino</th>
                            <th>Estado</th>
                            <th>Vigencia</th>
                            <th width="160">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.PartidoOrigen</td>

                                <td>@item.PartidoDestino</td>

                                <td>
                                    @if (item.Estado == "Activa")
                                    {
                                        <span class="badge-active">
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactive">
                                            @item.Estado
                                        </span>
                                    }
                                </td>

                                <td>@item.Vigente</td>

                                <td>
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn-warning-custom">
                                        <i class="bi bi-pencil-square"></i>
                                        Editar
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </main>
    ```

</body>
</html>
