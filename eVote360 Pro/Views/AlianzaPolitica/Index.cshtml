</head>

<body>

<div class="page-container">

    <div class="content-card">

        <div class="d-flex justify-content-between mb-3">

            <h2>Alianzas Políticas</h2>

            <a asp-action="CrearSolicitud"
               class="btn-main">
                Nueva Solicitud
            </a>

        </div>

        <table class="table">

            <thead>
                <tr>
                    <th>Partido Origen</th>
                    <th>Partido Destino</th>
                    <th>Estado</th>
                    <th>Vigente</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.PartidoOrigen</td>

                        <td>@item.PartidoDestino</td>
                        <td>@item.Estado</td>
                        <td>
                            @(item.Vigente ? "Sí" : "No")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

    </main>
