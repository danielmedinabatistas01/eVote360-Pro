@using eVote360Pro.Core.Application.ViewModels.AlianzaPolitica
@model List<SolicitudAlianzaViewModel>

<div class="page-container">

    <div class="content-card">

        <h2>Solicitudes Pendientes</h2>

        <table class="table">

            <thead>
                <tr>
                    <th>Origen</th>
                    <th>Destino</th>
                    <th>Fecha</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.PartidoOrigen</td>

                        <td>@item.PartidoDestino</td>

                        <td>
                            @item.FechaSolicitud
                        </td>

                        <td>

                            <a class="btn-main"
                               asp-action="Aceptar"
                               asp-route-id="@item.Id">
                                Aceptar
                            </a>

                            <a class="btn-delete"
                               asp-action="Rechazar"
                               asp-route-id="@item.Id">
                                Rechazar
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>