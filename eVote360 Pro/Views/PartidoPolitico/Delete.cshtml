@model eVote360Pro.Core.Application.ViewModels.PartidoPolitico.SavePartidoPoliticoViewModel

@{
    bool activar = !Model.EsActivo;
    ViewData["Title"] = activar ? "Activar Partido" : "Desactivar Partido";
}

<style>
    .page-header {
        margin-bottom: 2rem;
    }

    .page-header h1 {
        font-family: 'Syne', sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        color: #1B3A6B;
        margin: 0 0 .35rem;
    }

    .page-header p {
        font-size: .9rem;
        color: #6B7280;
        margin: 0;
    }

    .content-card {
        background: #fff;
        border: 1px solid #E5E7EB;
        border-radius: 12px;
        padding: 2rem;
        max-width: 650px;
        margin: 0 auto;
        box-shadow: 0 4px 12px rgba(0,0,0,.04);
    }

    .logo-preview {
        width: 90px;
        height: 90px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #E5E7EB;
        margin-bottom: 1rem;
    }

    .btn-confirm {
        border: none;
        border-radius: 8px;
        padding: .65rem 1rem;
        color: white;
        font-weight: 600;
    }

    .btn-confirm.activate {
        background: #16A34A;
    }

    .btn-confirm.activate:hover {
        background: #15803D;
    }

    .btn-confirm.deactivate {
        background: #DC2626;
    }

    .btn-confirm.deactivate:hover {
        background: #B91C1C;
    }

    .btn-back {
        background: #F8FAFC;
        color: #1B3A6B;
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        padding: .65rem 1rem;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-back:hover {
        background: #EEF2FF;
        color: #1B3A6B;
        text-decoration: none;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        margin-top: 2rem;
        flex-wrap: wrap;
        gap: .75rem;
    }

    dt {
        color: #1B3A6B;
    }
</style>

<div class="page-header">
    <h1>@(activar ? "Activar Partido Político" : "Desactivar Partido Político")</h1>
    <p>
        Confirme la acción que desea realizar sobre el partido político.
    </p>
</div>

<div class="content-card">

    @if (!string.IsNullOrEmpty(Model.LogoUrl))
    {
        <div class="text-center">
            <img src="@Model.LogoUrl"
                 class="logo-preview"
                 onerror="this.style.display='none'" />
        </div>
    }

    <div class="alert @(activar ? "alert-success" : "alert-warning")">
        <strong>
            @(activar
                ? "¿Está seguro que desea activar este partido político?"
                : "¿Está seguro que desea desactivar este partido político?")
        </strong>
    </div>

    <dl class="row">

        <dt class="col-sm-4">
            Nombre
        </dt>

        <dd class="col-sm-8">
            @Model.Nombre
        </dd>

        <dt class="col-sm-4">
            Siglas
        </dt>

        <dd class="col-sm-8">
            @Model.Siglas
        </dd>

        <dt class="col-sm-4">
            Estado actual
        </dt>

        <dd class="col-sm-8">
            @if (Model.EsActivo)
            {
                <span class="badge bg-success">Activo</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactivo</span>
            }
        </dd>

    </dl>

    <form asp-action="DeletePost" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <div class="form-actions">

            <a asp-action="Index" class="btn-back">
                <i class="bi bi-arrow-left"></i>
                Cancelar
            </a>

            @if (activar)
            {
                <button type="submit" class="btn-confirm activate">
                    <i class="bi bi-check-circle"></i>
                    Activar Partido
                </button>
            }
            else
            {
                <button type="submit" class="btn-confirm deactivate">
                    <i class="bi bi-trash"></i>
                    Desactivar Partido
                </button>
            }

        </div>

    </form>

</div>