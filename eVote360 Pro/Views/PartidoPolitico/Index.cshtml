@model List<eVote360Pro.Core.Application.ViewModels.PartidoPolitico.PartidoPoliticoViewModel>

@{
    ViewData["Title"] = "Partidos Políticos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Partidos Políticos</h2>

        @if (ViewBag.HasActiveElection == true)
        {
            <a href="#" class="btn btn-primary disabled" style="pointer-events: none; opacity: 0.6;">
                <i class="bi bi-plus-circle"></i>
                Nuevo Partido
            </a>
        }
        else
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Nuevo Partido
            </a>
        }
    </div>

    @if (ViewBag.HasActiveElection == true)
    {
        <div class="alert alert-warning mb-3">
            <i class="bi bi-exclamation-triangle-fill"></i>
            No se pueden modificar partidos políticos mientras exista una elección activa.
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @TempData["ErrorMessage"]
        </div>
    }

    <div class="mb-3">
        <a asp-controller="HomeAdministrador" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Volver al Home
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay partidos políticos registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Logo</th>
                        <th>Nombre</th>
                        <th>Siglas</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var partido in Model)
                    {
                        <tr>
                            <td>
                                <img src="@partido.LogoUrl"
                                     style="width:55px;height:55px;object-fit:cover;border-radius:50%;"
                                     onerror="this.src='https://via.placeholder.com/55'" />
                            </td>

                            <td>@partido.Nombre</td>
                            <td>@partido.Siglas</td>

                            <td>
                                @if (partido.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>

                            <td class="text-end">
                                 @if (ViewBag.HasActiveElection == true)
                                 {
                                     <a href="#" class="btn btn-warning btn-sm disabled" style="pointer-events: none; opacity: 0.6;">
                                         <i class="bi bi-pencil-square"></i>
                                         Editar
                                     </a>
                                 }
                                 else
                                 {
                                     <a asp-action="Edit"
                                        asp-route-id="@partido.Id"
                                        class="btn btn-warning btn-sm">
                                         <i class="bi bi-pencil-square"></i>
                                         Editar
                                     </a>
                                 }

                                 @if (ViewBag.HasActiveElection == true)
                                 {
                                     @if (partido.Activo)
                                     {
                                         <a href="#" class="btn btn-danger btn-sm disabled" style="pointer-events: none; opacity: 0.6;">
                                             <i class="bi bi-trash"></i>
                                             Desactivar
                                         </a>
                                     }
                                     else
                                     {
                                         <a href="#" class="btn btn-success btn-sm disabled" style="pointer-events: none; opacity: 0.6;">
                                             <i class="bi bi-arrow-clockwise"></i>
                                             Activar
                                         </a>
                                     }
                                 }
                                 else
                                 {
                                     @if (partido.Activo)
                                     {
                                         <a asp-action="Delete"
                                            asp-route-id="@partido.Id"
                                            class="btn btn-danger btn-sm">
                                             <i class="bi bi-trash"></i>
                                             Desactivar
                                         </a>
                                     }
                                     else
                                     {
                                         <a asp-action="Delete"
                                            asp-route-id="@partido.Id"
                                            class="btn btn-success btn-sm">
                                             <i class="bi bi-arrow-clockwise"></i>
                                             Activar
                                         </a>
                                     }
                                 }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>