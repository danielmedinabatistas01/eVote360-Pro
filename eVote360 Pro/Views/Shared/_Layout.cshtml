@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var isLoginPage = currentController == "Login" && currentAction == "Index";
    var isCreateUserPage = currentController == "Usuario" && currentAction == "Create";

    var hideMenu = isLoginPage || isCreateUserPage;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eVote360 Pro</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/eVote360_Pro.styles.css" asp-append-version="true" />

    <style>
            body {
                background: #F8FAFC;
                font-family: 'Inter', Arial, sans-serif;
                color: #374151;
                min-height: 100vh;
            }

            .main-navbar {
                background: #FFFFFF;
                border-bottom: 1px solid #E5E7EB;
                box-shadow: 0 4px 12px rgba(0,0,0,.04);
                padding: .9rem 0;
            }

            .brand-wrapper {
                display: flex;
                align-items: center;
                gap: .75rem;
                text-decoration: none;
            }

            .logo-box {
                width: 46px;
                height: 46px;
                background: #EEF2FF;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .brand-title {
                color: #1B3A6B;
                font-size: 1.35rem;
                font-weight: 800;
                margin: 0;
            }

            .nav-actions {
                display: flex;
                align-items: center;
                gap: .55rem;
                flex-wrap: wrap;
            }

            .nav-action-btn {
                background: #2563EB;
                color: white !important;
                border-radius: 8px;
                padding: .5rem .85rem !important;
                font-size: .84rem;
                font-weight: 700;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: .35rem;
                border: none;
                transition: .2s;
            }

                .nav-action-btn:hover {
                    background: #1D4ED8;
                    color: white !important;
                    text-decoration: none;
                }

                .nav-action-btn.secondary {
                    background: #F8FAFC;
                    color: #1B3A6B !important;
                    border: 1px solid #E5E7EB;
                }

                    .nav-action-btn.secondary:hover {
                        background: #EEF2FF;
                        color: #1B3A6B !important;
                    }

                .nav-action-btn.logout {
                    background: #FEF2F2;
                    color: #B91C1C !important;
                }

                    .nav-action-btn.logout:hover {
                        background: #FEE2E2;
                        color: #991B1B !important;
                    }

            .app-container {
                max-width: 1200px;
                margin: 0 auto;
                padding: 2rem 1rem;
            }

            .login-container {
                padding: 0;
                max-width: none;
            }

            .app-footer {
                border-top: 1px solid #E5E7EB;
                background: #FFFFFF;
                color: #6B7280;
                font-size: .85rem;
                padding: 1rem 0;
                margin-top: 2rem;
            }

            @@media (max-width: 992px) {
                .nav-actions {
                    margin-top: 1rem;
                    width: 100%;
                }

                .nav-action-btn {
                    width: 100%;
                    justify-content: center;
                }
            }
    </style>
</head>

<body>

    @if (!hideMenu)
    {
        <header>
            <nav class="navbar navbar-expand-lg main-navbar">
                <div class="container-fluid px-4">

                    <a class="brand-wrapper"
                       asp-controller="HomeAdministrador"
                       asp-action="Index">
                        <div class="logo-box">
                            <i class="bi bi-ballot-check fs-3 text-primary"></i>
                        </div>

                        <h1 class="brand-title">eVote360 Pro</h1>
                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNavbar"
                            aria-controls="mainNavbar"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <div class="nav-actions ms-auto">

                            <a asp-controller="HomeAdministrador"
                               asp-action="Index"
                               class="nav-action-btn secondary">
                                <i class="bi bi-house"></i>
                                Home
                            </a>

                            <a asp-controller="Usuario"
                               asp-action="Index"
                               class="nav-action-btn">
                                <i class="bi bi-person-gear"></i>
                                Usuarios
                            </a>

                            <a asp-controller="Ciudadano"
                               asp-action="Index"
                               class="nav-action-btn">
                                <i class="bi bi-person-vcard"></i>
                                Ciudadanos
                            </a>

                            <a asp-controller="PartidoPolitico"
                               asp-action="Index"
                               class="nav-action-btn">
                                <i class="bi bi-flag"></i>
                                Partidos
                            </a>

                            <a asp-controller="PuestoElectivo"
                               asp-action="Index"
                               class="nav-action-btn">
                                <i class="bi bi-award"></i>
                                Puestos
                            </a>

                            <a asp-controller="AsignacionDirigente"
                               asp-action="Index"
                               class="nav-action-btn">
                                <i class="bi bi-person-check"></i>
                                Dirigentes
                            </a>

                            <a asp-controller="Eleccion"
                               asp-action="Index"
                               class="nav-action-btn">
                                <i class="bi bi-calendar-check"></i>
                                Elecciones
                            </a>

                            <a asp-controller="Login"
                               asp-action="Logout"
                               class="nav-action-btn logout">
                                <i class="bi bi-box-arrow-right"></i>
                                Salir
                            </a>

                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main class="@(hideMenu ? "login-container" : "app-container") flex-grow-1">
        @RenderBody()
    </main>

    @if (!hideMenu)
    {
        <footer class="app-footer">
            <div class="container text-center">
                <i class="bi bi-shield-lock"></i>
                Panel administrativo seguro · © eVote360 Pro 2026
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>