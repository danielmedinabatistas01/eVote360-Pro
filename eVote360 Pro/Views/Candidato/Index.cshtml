@model List<eVote360Pro.Core.Application.ViewModels.Candidato.CandidatoViewModel>

@{
    ViewData["Title"] = "Candidatos";
}

<style>
    .page-container {
        padding: 2rem;
        background: #F8FAFC;
    }

    .card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 8px 25px rgba(0,0,0,.05);
    }

    .btn-main {
        background: #2563EB;
        color: white;
        text-decoration: none;
        padding: .75rem 1rem;
        border-radius: 8px;
    }

    table {
        width: 100%;
        margin-top: 1rem;
    }

    img {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 50%;
    }
</style>

<div class="page-container">

    <div class="card">

        <div class="d-flex justify-content-between">

            <h2>Candidatos</h2>

            <a asp-action="Create"
               class="btn-main">
                Crear candidato
            </a>

        </div>

        <table class="table">

            <thead>
                <tr>
                    <th>Foto</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <img src="/@item.FotoUrl" />
                        </td>

                        <td>@item.Nombre</td>

                        <td>@item.Apellido</td>

                        <td>
                            @(item.Estado
                                ? "Activo"
                                : "Inactivo")
                        </td>

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id">
                                Editar
                            </a>

                            |


                            <a asp-action="Activar"
                               asp-route-id="@item.Id">
                                Activar
                            </a>

                             |

                            <a asp-action="Desactivar"
                               asp-route-id="@item.Id">
                                Desactivar
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>