@model List<eVote360Pro.Core.Application.ViewModels.Candidato.CandidatoViewModel>

@{
    ViewData["Title"] = "Candidatos";
}

<style>
    .page-container {
        padding: 2rem;
        background: #F8FAFC;
        min-height: 100vh;
    }

    .content-card {
        width: 100%;
        max-width: 1100px;
        background: white;
        border: 1px solid #E5E7EB;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 8px 25px rgba(0,0,0,.05);
        margin: 0 auto;
    }

    .btn-main {
        background: #2563EB;
        color: white;
        border-radius: 8px;
        padding: .65rem 1rem;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-main:hover {
        background: #1D4ED8;
        color: white;
    }

    img {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 50%;
    }
</style>

<div class="page-container">
    <div class="content-card">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>Candidatos</h1>
                <p>Gestionar candidatos del partido político.</p>
            </div>

            <a asp-action="Create" class="btn-main">
                Crear candidato
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Foto</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                No hay candidatos registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="/@item.FotoUrl" alt="Foto del candidato" />
                                </td>

                                <td>@item.Nombre</td>
                                <td>@item.Apellido</td>

                                <td>
                                    @(item.Estado ? "Activo" : "Inactivo")
                                </td>

                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                        Editar
                                    </a>

                                    <a asp-action="Activar" asp-route-id="@item.Id" class="btn btn-success btn-sm">
                                        Activar
                                    </a>

                                    <a asp-action="Desactivar" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                        Desactivar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>