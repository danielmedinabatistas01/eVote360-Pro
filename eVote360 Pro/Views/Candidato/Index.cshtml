@model List<eVote360Pro.Core.Application.ViewModels.Candidato.CandidatoViewModel>

@{
    Layout = null;
    ViewData["Title"] = "Candidatos";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Candidatos - eVote360 Pro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .page-container {
        padding: 2rem;
        background: #F8FAFC;
                min-height: 100vh;
    }

    .card {
        background: white;
                border-bottom: 1px solid #E5E7EB;
                padding: 1rem 2rem;
            }

            .brand-title {
                color: #1B3A6B;
                font-size: 1.8rem;
                font-weight: 700;
                margin: 0;
            }

            .logo-box {
                width: 54px;
                height: 54px;
                background: #EEF2FF;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .page-wrapper {
                min-height: calc(100vh - 90px);
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 2rem;
            }

            .content-card {
                width: 100%;
                max-width: 1100px;
                background: white;
                border: 1px solid #E5E7EB;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 8px 25px rgba(0,0,0,.05);
    }

            .page-header {
                text-align: center;
                margin-bottom: 2rem;
            }

            .icon-box {
                width: 70px;
                height: 70px;
                background: #EFF6FF;
                border-radius: 14px;
                display: inline-flex;
                justify-content: center;
                align-items: center;
                margin-bottom: 1rem;
            }

            .page-header h1 {
                color: #1B3A6B;
                font-weight: 700;
            }

            .page-header p {
                color: #6B7280;
            }

    .btn-main {
        background: #2563EB;
        color: white;
                border-radius: 8px;
                padding: .65rem 1rem;
                font-weight: 600;
        text-decoration: none;
        padding: .75rem 1rem;
        border-radius: 8px;
                padding: .45rem .8rem;
                font-weight: 600;
                text-decoration: none;
    }

    table {
        width: 100%;
        margin-top: 1rem;
    }

    img {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 50%;
    }
</style>
</head>

<body>

<div class="page-container">

    <div class="card">

        <div class="d-flex justify-content-between">

            <h2>Candidatos</h2>

            <a asp-action="Create"
               class="btn-main">
                Crear candidato
            </a>

                <h1>Candidatos</h1>
                <p>Gestionar candidatos del partido político.</p>
        </div>

        <table class="table">

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Foto</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <img src="/@item.FotoUrl" />
                        </td>

                        <td>@item.Nombre</td>

                        <td>@item.Apellido</td>

                        <td>
                            @(item.Estado
                                ? "Activo"
                                : "Inactivo")
                        </td>

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id">
                                Editar
                            </a>

                            |

                            <a asp-action="Delete"
                               asp-route-id="@item.Id">
                                Eliminar
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
            </div>

    </div>
    </main>

</div>