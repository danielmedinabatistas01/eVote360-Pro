@model eVote360Pro.Core.Application.ViewModels.Voto.EmitirVotoViewModel

@{
    Layout = null;
    ViewData["Title"] = "Puestos Electivos";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>eVote360 Pro - Puestos Electivos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            body {
                background: #F8FAFC;
                min-height: 100vh;
            }

            .page-wrapper {
                padding: 2rem;
            }

            .content-card {
                max-width: 900px;
                margin: auto;
                background: white;
                border-radius: 16px;
                padding: 2rem;
                border: 1px solid #E5E7EB;
                box-shadow: 0 4px 12px rgba(0,0,0,.04);
            }

            .step-grid {
                display: grid;
                grid-template-columns: repeat(4,1fr);
                gap: .75rem;
                margin-bottom: 2rem;
            }

            .step-item {
                text-align: center;
            }

            .step-number {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: #1B3A6B;
                color: white;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
            }

            .step-label {
                margin-top: .35rem;
                font-size: .8rem;
                font-weight: 600;
                color: #1B3A6B;
            }

            .page-title {
                text-align: center;
                margin-bottom: 2rem;
            }

            .puesto-card {
                border: 1px solid #E5E7EB;
                border-radius: 12px;
                padding: 1.25rem;
                margin-bottom: 1rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                background: #F8FAFC;
            }

            .btn-start {
                background: #2563EB;
                color: white;
                border: none;
                font-weight: 600;
            }

            .btn-start:hover {
                background: #1D4ED8;
                color: white;
            }
    </style>
</head>
<body>

    <div class="page-wrapper">
        <div class="content-card">

            <div class="step-grid">
                <div class="step-item">
                    <div class="step-number">✓</div>
                    <div class="step-label">Documento</div>
                </div>

                <div class="step-item">
                    <div class="step-number">✓</div>
                    <div class="step-label">Identidad</div>
                </div>

                <div class="step-item">
                    <div class="step-number">✓</div>
                    <div class="step-label">Código</div>
                </div>

                <div class="step-item">
                    <div class="step-number">4</div>
                    <div class="step-label">Votación</div>
                </div>
            </div>

            <div class="page-title">
                <h2>Cargos en esta Elección</h2>
                <p class="text-muted">
                    Usted emitirá un voto por cada uno de los siguientes cargos electivos disponibles.
                </p>
            </div>

            <div class="mb-4">
                @foreach (var puesto in Model.Selecciones)
                {
                    <div class="puesto-card">
                        <div>
                            <h5 class="mb-1 fw-bold">@puesto.NombrePuesto</h5>
                            <small class="text-muted">
                                Candidatos postulados: @puesto.Candidatos.Count
                            </small>
                        </div>
                        <div>
                            <span class="badge bg-secondary px-3 py-2 rounded-pill">Disponible</span>
                        </div>
                    </div>
                }
            </div>

            <form asp-controller="ProcesoVotacion" asp-action="Puestos" method="post" class="text-center">
                @Html.AntiForgeryToken()
                
                <input type="hidden" asp-for="CiudadanoId" />
                <input type="hidden" asp-for="EleccionId" />
                
                @for (int i = 0; i < Model.Selecciones.Count; i++)
                {
                    <input type="hidden" asp-for="Selecciones[i].PuestoElectivoId" />
                    <input type="hidden" asp-for="Selecciones[i].NombrePuesto" />
                    <input type="hidden" asp-for="Selecciones[i].CandidatoId" />
                }

                <button type="submit" class="btn btn-start btn-lg px-5 py-3 shadow-sm rounded-3">
                    <i class="bi bi-play-fill me-2"></i> Comenzar Votación
                </button>
            </form>

        </div>
    </div>

</body>
</html>