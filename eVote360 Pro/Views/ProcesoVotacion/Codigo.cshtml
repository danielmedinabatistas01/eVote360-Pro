@model eVote360Pro.Core.Application.ViewModels.CodigoVerificacion.CodigoVerificacionViewModel

@{
    ViewData["Title"] = "Código";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>eVote360 Pro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            body {
                background: #F8FAFC;
                min-height: 100vh;
            }

            .navbar-custom {
                background: #FFFFFF;
                border-bottom: 1px solid #E5E7EB;
                padding: 1rem 2rem;
            }

            .navbar-brand-wrapper {
                display: flex;
                align-items: center;
                gap: 1rem;
            }

            .logo-box {
                width: 54px;
                height: 54px;
                background: #EEF2FF;
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .brand-title {
                color: #1B3A6B;
                font-size: 1.8rem;
                font-weight: 700;
                margin: 0;
            }

            .login-btn {
                border: 1px solid #1B3A6B;
                color: #1B3A6B;
                font-weight: 600;
                border-radius: 8px;
                padding: .5rem 1rem;
            }

                .login-btn:hover {
                    background: #1B3A6B;
                    color: white;
                }

            .page-wrapper {
                min-height: calc(100vh - 90px);
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 2rem;
            }

            .content-card {
                width: 100%;
                max-width: 540px;
                background: white;
                border: 1px solid #E5E7EB;
                border-radius: 16px;
                padding: 2rem;
                box-shadow: 0 4px 12px rgba(0,0,0,.04);
            }

            .step-grid {
                display: grid;
                grid-template-columns: repeat(4,1fr);
                gap: .75rem;
                margin-bottom: 2rem;
            }

            .step-item {
                text-align: center;
            }

            .step-number {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: #E5E7EB;
                color: #6B7280;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
            }

            .step-item.active .step-number {
                background: #2563EB;
                color: white;
            }

            .step-item.completed .step-number {
                background: #1B3A6B;
                color: white;
            }

            .step-label {
                margin-top: .35rem;
                font-size: .8rem;
                font-weight: 600;
                color: #6B7280;
            }

            .step-item.active .step-label {
                color: #2563EB;
            }

            .step-item.completed .step-label {
                color: #1B3A6B;
            }

            .page-header {
                text-align: center;
                margin-bottom: 2rem;
            }

                .page-header h1 {
                    font-size: 1.8rem;
                    font-weight: 700;
                    color: #1B3A6B;
                }

                .page-header p {
                    color: #6B7280;
                    margin-top: .5rem;
                }

            .icon-box {
                width: 60px;
                height: 60px;
                background: #EFF6FF;
                color: #1B3A6B;
                border-radius: 14px;
                display: inline-flex;
                justify-content: center;
                align-items: center;
                margin-bottom: 1rem;
            }

            .form-label {
                color: #1B3A6B;
                font-weight: 600;
            }

            .form-control {
                border-radius: 8px;
                border: 1px solid #E5E7EB;
                padding: .85rem;
                text-align: center;
                font-size: 1.25rem;
                font-weight: 700;
                letter-spacing: .2rem;
            }

                .form-control:focus {
                    border-color: #2563EB;
                    box-shadow: 0 0 0 .2rem rgba(37,99,235,.15);
                }

            .action-btn {
                background: #2563EB;
                color: white;
                border: none;
                padding: .85rem;
                border-radius: 8px;
                font-weight: 600;
            }

                .action-btn:hover {
                    background: #1D4ED8;
                    color: white;
                }

            .footer-text {
                color: #6B7280;
                font-size: .85rem;
            }
    </style>
</head>

<body>

    <nav class="navbar navbar-custom">
        <div class="container-fluid">

            <div class="navbar-brand-wrapper">
                <div class="logo-box">
                    <i class="bi bi-check-square-fill fs-3 text-primary"></i>
                </div>

                <h1 class="brand-title">eVote360 Pro</h1>
            </div>

            <a asp-controller="Login"
               asp-action="Index"
               class="btn login-btn">
                <i class="bi bi-box-arrow-in-right"></i>
                Acceder
            </a>

        </div>
    </nav>

    <main class="page-wrapper">
        <div class="content-card">

            <div class="step-grid">
                <div class="step-item completed">
                    <div class="step-number">1</div>
                    <div class="step-label">Documento</div>
                </div>

                <div class="step-item completed">
                    <div class="step-number">2</div>
                    <div class="step-label">Identidad</div>
                </div>

                <div class="step-item active">
                    <div class="step-number">3</div>
                    <div class="step-label">Código</div>
                </div>

                <div class="step-item">
                    <div class="step-number">4</div>
                    <div class="step-label">Votación</div>
                </div>
            </div>

            <div class="page-header">
                <div class="icon-box">
                    <i class="bi bi-envelope-check fs-3"></i>
                </div>

                <h1>Código de verificación</h1>

                <p>
                    Ingrese el código enviado a su correo electrónico para continuar con el proceso de votación.
                </p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <form asp-controller="ProcesoVotacion"
                  asp-action="Codigo"
                  method="post">

                @Html.AntiForgeryToken()

         <input asp-for="CiudadanoId" type="hidden" />
<input asp-for="EleccionId" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Codigo" class="form-label"></label>

                    <input asp-for="Codigo"
                           class="form-control"
                           placeholder="123456"
                           maxlength="6" />

                    <span asp-validation-for="Codigo" class="text-danger"></span>
                </div>

                <button type="submit" class="btn action-btn w-100">
                    <i class="bi bi-check-circle"></i>
                    Validar código
                </button>
            </form>

            <div class="text-center footer-text mt-4">
                <i class="bi bi-lock"></i>
                Proceso confidencial y seguro · © ITLA 2026
            </div>

        </div>
    </main>

</body>
</html>