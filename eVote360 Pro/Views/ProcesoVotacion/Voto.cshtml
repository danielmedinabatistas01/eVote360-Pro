@model eVote360Pro.Core.Application.ViewModels.Voto.EmitirVotoViewModel

@{
    ViewData["Title"] = "Emitir voto";
}

<div class="confirm-wrapper">

    <div class="content-card">

        <h1>Emitir voto</h1>

        <p>
            Seleccione los candidatos correspondientes para cada puesto electivo.
        </p>

        <form asp-action="Votar"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            @foreach (var puesto in Model.Selecciones)
            {
                <div class="mb-3 text-start">

                    <label class="form-label">
                        @puesto.NombrePuesto
                    </label>

                    <select class="form-select"
                            name="selecciones">

                        <option value="">
                            Seleccione
                        </option>

                        @foreach (var candidato in puesto.Candidatos)
                        {
                            <option value="@candidato.Value">
                                @candidato.Text
                            </option>
                        }

                    </select>

                </div>
            }

            <div class="buttons">

                <a asp-action="Codigo"
                   class="btn-delete">
                    Volver
                </a>

                <button type="submit"
                        class="btn-main">
                    Emitir voto
                </button>

            </div>

        </form>

    </div>

</div>